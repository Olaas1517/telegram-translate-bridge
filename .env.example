# telegram user api credentials - https://my.telegram.org (log in with the listener account)
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here

# bot token from @BotFather - add the bot as admin of the target channel
BOT_TOKEN=123456:ABC-your-bot-token

# free gemini key - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# channels + model
SOURCE_CHANNEL=AjaNews
TARGET_CHANNEL=@englishaljazeera
GEMINI_MODEL=gemini-flash-latest
